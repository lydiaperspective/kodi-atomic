[Unit]
Description=Install system Flatpaks on first boot
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/flatpak-setup.done

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
ExecStart=/usr/bin/flatpak install --system -y --noninteractive flathub app.grayjay.Grayjay
ExecStartPost=/usr/bin/touch /var/lib/flatpak-setup.done
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target