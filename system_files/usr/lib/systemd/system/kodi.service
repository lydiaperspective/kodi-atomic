[Unit]
Description=Kodi kiosk
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service network-online.target sound.target
Conflicts=getty@tty1.service

[Service]
User=kodi
SupplementaryGroups=video render audio input
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /usr/bin/kodi-standalone
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
